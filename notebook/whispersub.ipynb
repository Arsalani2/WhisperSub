    "try:\n",
    "    from google.colab import userdata\n",
    "except ImportError:\n",
    "    userdata = None\n",
    "\n",
    "def get_secret(name):\n",
    "    \"\"\"خواندن امن Secret؛ در Colab از Secrets و در محیط محلی از متغیرهای محیطی (None اگر موجود نبود) — فیکس P1-1 + FB-03.\n",
