    "        return False\n",
    "\n",
    "if SENDER_EMAIL and SENDER_APP_PASSWORD and RECEIVER_EMAIL:\n",
    "    print(f\"[Info] ایمیل فرستنده تنظیم شد: {SENDER_EMAIL}\")\n",
